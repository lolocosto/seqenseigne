% \subsection{Tableau de conversion (v0.11)}
% \DescribeMacro{\seqTableauConversionSix}\DescribeMacro{\seqLigneConversionSix}
% Tous les tableaux de conversion des documents ont la même mise en forme :
% \cs{seqTableauConversionSix}\oarg{options}\marg{lignes} trace l'en-tête des unités
% (fond \texttt{seqSixEnteteTab}, unités en gras), puis les \meta{lignes}, chacune
% donnée par \cs{seqLigneConversionSix}. Le tableau est une boîte : on le centre
% avec \cs{centerline} ou on le place dans une \texttt{minipage}. Avec les réglages
% par défaut, il mesure environ 6\,cm de large et tient dans un exercice au quart
% d'A4.
%
% Les \meta{options} (clés \meta{clé}|=|\meta{valeur}, séparées par des virgules) :
% \begin{itemize}
% \item |grandeur| : |longueur| (par défaut : km, hm, dam, m, dm, cm, mm),
%   |masse| (kg \dots\ mg), |contenance| (kL \dots\ mL) ou |aire| (km$^2$ \dots\
%   mm$^2$, deux colonnes par unité, séparées par un filet gris) ;
% \item |hectares| (aires seulement) : |hectares| ou |hectares=ha| ajoute sous
%   l'en-tête une ligne « ha » sous hm$^2$ ; |hectares=ha-a-ca| y ajoute aussi
%   « a » sous dam$^2$ et « ca » sous m$^2$ ;
% \item |prefixes| et |valeurs| (longueurs, masses, contenances) ajoutent les lignes
%   « Préfixe » (kilo, hecto, déca, déci, centi, milli) et « Valeur » (1\,000~m
%   \dots\ 0,001~m), avec une colonne d'étiquettes à gauche (« Unité », « Préfixe »,
%   « Valeur ») ;
% \item |note| ajoute à droite une colonne de commentaire (la lecture du tableau,
%   par exemple « 35~cm $=$ 0,35~m »), remplie par l'argument optionnel de chaque ligne ;
% \item |compact| : caractères plus petits et lignes plus serrées, pour un tableau
%   placé dans un exercice au quart d'A4 déjà bien rempli ;
% \item |colonne|\,=\,\meta{dimension} : largeur d'une colonne d'unité (0,8\,cm par
%   défaut ; pour les aires, chacune des deux colonnes d'une unité en a la moitié) ;
%   |largeur|\,=\,\meta{dimension} : largeur totale des colonnes d'unités, qui
%   remplace |colonne|.
% \end{itemize}
%
% \cs{seqLigneConversionSix}\oarg{note}\marg{nombre}\marg{unité} écrit le
% \meta{nombre} dans le tableau, un chiffre par colonne, le chiffre des unités dans
% la colonne de l'\meta{unité} (pour les aires, dans la colonne de droite de
% l'unité ; |ha|, |a| et |ca| valent hm, dam et m). La virgule suit le chiffre
% des unités. Le \meta{nombre} s'écrit avec la virgule (|0,35|, |0{,}0045|, |12\,400| :
% les espaces et \cs{,} sont ignorés) ; on peut garder les zéros de tête pour
% montrer tous les chiffres d'une conversion (|0005,6| dans la colonne des dm :
% 0,005\,6~hm $=$ 5,6~dm). Un \meta{nombre} vide donne une ligne vide.
%
% Sans étoile, les chiffres sont \emph{donnés} : ils s'affichent dans les deux
% versions (exemple d'une fiche de cours). La forme étoilée
% \cs{seqLigneConversionSix*} donne une \emph{réponse} : cases vides (même
% hauteur) dans la version élève, chiffres en rouge gras dans la version corrigée
% ou complète, comme les autres réponses (\cs{seqLocCellule}).
%
% Exemples :
% \begin{verbatim}
% \centerline{\seqTableauConversionSix[note]{%
%   \seqLigneConversionSix[$35$~cm $= 0{,}35$~m]{0,35}{m}
%   \seqLigneConversionSix[$8{,}12$~m $= 812$~cm]{812}{cm}}}
% \seqTableauConversionSix[grandeur=aire, hectares]{%
%   \seqLigneConversionSix*{0,0567}{m}
%   \seqLigneConversionSix{}{}}
% \end{verbatim}
% Les durées ne se convertissent pas dans un tableau (on compte par 60) : le module
% n'en propose pas.
%
% \subsection{Tableau décimal à quatre classes (v0.12)}
% \DescribeMacro{\seqLocTableauDecimal}
% \cs{seqLocTableauDecimal}\marg{lignes} trace le tableau de position d'un nombre
% décimal : classe des milliers, classe des unités, une colonne étroite pour la
% virgule, puis dixièmes, centièmes et millièmes (10 cellules par ligne). Chaque
% ligne donne ses cellules séparées par |&| et se termine par |\\ \hline|.
%
% \cs{seqLocTableauDecimal}\oarg{4}\marg{lignes} ajoute à gauche la classe des
% \emph{millions} (couleur \texttt{seqLocMillions}) et celle des \emph{milliards}
% (\texttt{seqLocMilliards}, blanc, comme dans \cs{seqLocTableauNumeration}) :
% 16 cellules par ligne (12 chiffres de la partie entière, la virgule, 3 chiffres
% de la partie décimale). Pour tenir dans une fiche de cours, les colonnes sont plus
% étroites (0,6\,cm au lieu de 0,62\,cm, espacement réduit), les rangs et les noms
% des classes sont écrits en \cs{footnotesize} ; un filet épais
% sépare les classes, pour que le tableau reste lisible imprimé en noir et blanc
% (environ 12,5\,cm de large, comme \cs{seqLocTableauNumeration}).
%
% L'argument optionnel vaut |2| par défaut : un tableau écrit sans lui garde
% exactement son rendu d'avant la v0.12. Une autre valeur que |2| ou |4| est une
% erreur.
% \begin{verbatim}
% \seqLocTableauDecimal[4]{ & & & & & & & & 5 & 0 & 4 & 8 & , & 3 & 7 & 2\\ \hline}
% \end{verbatim}
%
% \subsection{Carte mentale de partie (v0.13)}
% \DescribeEnv{seqCarteMentaleSix}\DescribeMacro{\seqCMBranche}
% Une carte mentale résume une partie de séquence sur une page A4 portrait au plus.
% \begin{verbatim}
% \begin{seqCarteMentaleSix}[contenu sous le titre central]{Titre central}
%   \seqCMBranche{Titre de la branche 1}{contenu}
%   \seqCMBranche{Titre de la branche 2}{contenu}
%   ...
% \end{seqCarteMentaleSix}
% \end{verbatim}
% La bulle centrale porte le \meta{titre central} et, sous un filet, le contenu
% facultatif. Les branches (4 à 8 conseillées, de 1 à 16 acceptées) se rangent en
% deux colonnes, dans le sens anti-horaire : la colonne de gauche reçoit les
% $\lceil n/2\rceil$ premières branches de haut en bas, la colonne de droite les
% suivantes de bas en haut. Deux branches d'une même colonne sont séparées par
% 5\,mm au moins ; les branches de chaque colonne se répartissent sur toute la
% hauteur de la carte, qui occupe toute la hauteur disponible. Un trait de la couleur de la branche la relie
% à la bulle.
%
% Chaque branche est un cadre à bord épais de sa couleur et à fond clair, lisible
% imprimé en noir et blanc ; son titre est en gras sur un bandeau un peu plus foncé.
% La palette suit l'ordre des branches et recommence après la huitième :
% \texttt{seqSixCM1} à \texttt{seqSixCM8} (bleu, rouge, vert, orange, violet,
% bleu canard, framboise, brun).
%
% Le contenu d'une branche peut contenir plusieurs paragraphes, des formules, de
% petits tableaux, des \texttt{tikzpicture} et des figures \textsf{tkz-euclide} :
% chaque branche est composée dans une boîte \emph{avant} la figure d'ensemble, il
% n'y a donc pas de \texttt{tikzpicture} imbriqué. La largeur utile d'une branche
% est d'environ 7,6\,cm avant réduction. Les trous s'écrivent avec \cs{seqACompleter}
% (pointillés en version élève, réponse en rouge en version complète) :
% \cs{seqVersionACompleter} ou \cs{seqVersionComplete} avant la carte.
%
% La bulle a un texte de 2,9\,cm de large, élargi au mot le plus long du titre
% (« Proportionnalité ») ; on ne coupe pas les mots du titre. La gouttière entre les
% colonnes (4\,cm au moins) s'élargit d'autant. Une branche dont le contenu contient
% \cs{foreach} est relue avec un point-virgule ordinaire : le |;| que \textsf{babel}
% (français) rend actif ne gêne plus la boucle (le point-virgule du texte de cette
% branche perd alors son espace fine).
%
% \paragraph{Réduction automatique.} La carte est dessinée sur une largeur de
% 20\,cm (plus si la bulle l'exige), puis réduite pour tenir dans la largeur de la ligne et dans la hauteur
% qui reste sur la page (une page entière si moins de la moitié de la page reste
% libre). Elle n'est jamais agrandie ; quand elle est moins haute que la place
% disponible, elle est étirée en hauteur (les branches s'écartent) pour occuper toute
% cette place. Elle ne coupe donc jamais une page ; un contenu très chargé donne
% seulement une carte plus petite.
%
% \StopEventually{}
%
