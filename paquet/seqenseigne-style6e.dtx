% \begin{macro}{\seqSuiviObjectifsSix}\begin{macro}{\seqPartieSuiviSix}
% \changes{v0.14}{2026/11/13}{\cs{seqSuiviObjectifsSix} et
%   \cs{seqPartieSuiviSix} : page de garde avec suivi par objectif}
% v0.14 (décision de Laurent, 13 novembre : « suivi par objectif ») : la page de
% garde devient un tableau, une ligne par objectif (code et intitulé à gauche), trois
% cases à cocher « Je me suis entraîné », « J'ai approfondi », « Je suis expert » (une
% par série : Entraînement, Approfondissement, Expertise) et une case « Test court »
% pour la note sur 10. Au-dessus, la consigne « Coche une case seulement quand tu as
% fini toute la série. » ; au-dessous, la légende des mentions des exercices
% (O obligatoire, R remédiation, F facultatif). Les en-têtes de colonnes sont écrits une seule
% fois, en haut du tableau ; chaque partie a sa ligne de titre, de la couleur
% \texttt{seqSixTheme}. Les cases restent vides dans toutes les versions (élève,
% corrigé). Les lignes sont rangées dans une liste de lexèmes par
% \cs{seqPartieSuiviSix} (les |&| sont lus au niveau de l'alignement), puis le
% tableau est composé en boîte : s'il dépasse la place restante sur la page, on
% resserre (police \cs{footnotesize}, interligne réduit), puis, en dernier recours,
% on le réduit : il tient toujours sur une page.
%    \begin{macrocode}
\ExplSyntaxOn
\tl_new:N \l__seqsix_suivi_lignes_tl
\box_new:N \l__seqsix_suivi_box
\dim_new:N \l__seqsix_suivi_dispo_dim
\dim_new:N \l__seqsix_suivi_objectif_dim
\cs_new_protected:Npn \__seqsix_suivi_case:
  { \tikz[baseline=0.4ex] \draw [ line~width = 0.6pt , black!65 ]
      (0,0) rectangle (4mm,4mm) ; }
\cs_new_protected:Npn \__seqsix_suivi_note:
  { \makebox[1.1cm]{\dotfill} \, / \, 10 }
\cs_new_protected:Npn \__seqsix_suivi_ligne:w #1 / #2 \q_stop
  {
    \tl_put_right:Nn \l__seqsix_suivi_lignes_tl
      {
        {\bfseries\color{seqSixTheme} #1} \ #2
        & \__seqsix_suivi_case: & \__seqsix_suivi_case: & \__seqsix_suivi_case:
        & \__seqsix_suivi_note: \tabularnewline \hline
      }
  }
\cs_new_protected:Npn \__seqsix_suivi_partie:nn #1#2
  {
    \tl_put_right:Nn \l__seqsix_suivi_lignes_tl
      {
        \rowcolor{seqSixTheme!14}
        \multicolumn{5}{@{\hspace{4pt}}l}{\bfseries\color{seqSixTheme}#1}
        \tabularnewline \hline
      }
    \clist_map_inline:nn {#2} { \__seqsix_suivi_ligne:w ##1 \q_stop }
  }
\cs_new_protected:Npn \__seqsix_suivi_composer:Nn #1#2
  {
    % #1 : taille de police ; #2 : \arraystretch
    \hbox_set:Nn \l__seqsix_suivi_box
      {
        #1
        \setlength{\tabcolsep}{4pt}
        \renewcommand{\arraystretch}{#2}
        \arrayrulecolor{black!30}
        \dim_set:Nn \l__seqsix_suivi_objectif_dim
          { \linewidth - 3 \c__seqsix_suivi_case_dim
            - \c__seqsix_suivi_note_dim - 10 \tabcolsep - 6\arrayrulewidth }
        \begin{tabular}
          { | >{\raggedright\arraybackslash}m{\l__seqsix_suivi_objectif_dim}
            | *{3}{ >{\centering\arraybackslash}m{\c__seqsix_suivi_case_dim} |}
              >{\centering\arraybackslash}m{\c__seqsix_suivi_note_dim} | }
          \hline
          \rowcolor{seqSixTheme}
          \color{white}\bfseries Objectif
          & \color{white}\bfseries Je~me~suis \newline entraîné
          & \color{white}\bfseries J'ai \newline approfondi
          & \color{white}\bfseries Je~suis \newline expert
          & \color{white}\bfseries Test \newline court
          \tabularnewline \hline
          \tl_use:N \l__seqsix_suivi_lignes_tl
        \end{tabular}
      }
  }
\dim_const:Nn \c__seqsix_suivi_case_dim { 1.85cm }
\tl_new:N \l__seqsix_suivi_consigne_tl
\tl_set:Nn \l__seqsix_suivi_consigne_tl
  { Coche~une~case~seulement~quand~tu~as~fini~toute~la~série. }
\tl_new:N \l__seqsix_suivi_legende_tl
\tl_set:Nn \l__seqsix_suivi_legende_tl
  { \textbf{O}~:~obligatoire~---~\textbf{R}~:~remédiation~---~\textbf{F}~:~facultatif }
\dim_const:Nn \c__seqsix_suivi_note_dim { 2.05cm }
\NewDocumentCommand{\seqPartieSuiviSix}{ m m }
  { \__seqsix_suivi_partie:nn {#1} {#2} }
\NewDocumentCommand{\seqSuiviObjectifsSix}{ +m }
  {
    \par
    \group_begin:
      \tl_clear:N \l__seqsix_suivi_lignes_tl
      #1
      % consigne (Laurent, 13 nov., 12 h 12), sous « Objectifs du chapitre »
      \noindent{\small\itshape \l__seqsix_suivi_consigne_tl}\par\smallskip
      \dim_compare:nNnTF { \pagegoal } = { \maxdimen }
        { \dim_set:Nn \l__seqsix_suivi_dispo_dim { \textheight - \pagetotal } }
        { \dim_set:Nn \l__seqsix_suivi_dispo_dim { \pagegoal - \pagetotal } }
      \dim_sub:Nn \l__seqsix_suivi_dispo_dim { 3\baselineskip }
      \__seqsix_suivi_composer:Nn \small { 2.0 }
      \dim_compare:nNnT
        { \box_ht_plus_dp:N \l__seqsix_suivi_box } > { \l__seqsix_suivi_dispo_dim }
        { \__seqsix_suivi_composer:Nn \small { 1.6 } }
      \dim_compare:nNnT
        { \box_ht_plus_dp:N \l__seqsix_suivi_box } > { \l__seqsix_suivi_dispo_dim }
        { \__seqsix_suivi_composer:Nn \small { 1.25 } }
      \dim_compare:nNnT
        { \box_ht_plus_dp:N \l__seqsix_suivi_box } > { \l__seqsix_suivi_dispo_dim }
        { \__seqsix_suivi_composer:Nn \footnotesize { 1.1 } }
      \dim_compare:nNnT
        { \box_ht_plus_dp:N \l__seqsix_suivi_box } > { \l__seqsix_suivi_dispo_dim }
        { \box_resize_to_ht_plus_dp:Nn \l__seqsix_suivi_box
            { \l__seqsix_suivi_dispo_dim } }
      \noindent \box_use_drop:N \l__seqsix_suivi_box \par
      \smallskip
      \noindent{\footnotesize \l__seqsix_suivi_legende_tl}\par
    \group_end:
  }
\ExplSyntaxOff
