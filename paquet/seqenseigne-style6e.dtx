% \subsection{Tableau de conversion (v0.11)}
% \begin{macro}{\seqTableauConversionSix}\begin{macro}{\seqLigneConversionSix}
% \changes{v0.11}{2026/10/25}{\cs{seqTableauConversionSix} et
%   \cs{seqLigneConversionSix} : tableau de conversion commun}
% Le tableau est un \texttt{tabular} dont le préambule et les lignes d'en-tête sont
% calculés (\textsf{expl3}). Une ligne est construite dans une liste de lexèmes
% (chiffres, |&|, \cs{tabularnewline}, \cs{hline}) puis rendue d'un coup dans la
% première cellule : les |&| sont lus au niveau de l'alignement. La virgule est
% posée par \cs{rlap} : le chiffre reste centré dans sa colonne. Une réponse passe
% par \cs{seqLocCellule} (rouge en version corrigée, fantôme en version élève).
%    \begin{macrocode}
\RequirePackage{colortbl}
\ExplSyntaxOn
\seq_new:N \l__seqsix_conv_symboles_seq
\seq_new:N \l__seqsix_conv_prefixes_seq
\seq_new:N \l__seqsix_conv_valeurs_seq
\seq_new:N \l__seqsix_conv_noms_seq
\tl_new:N \l__seqsix_conv_principale_tl
\tl_new:N \l__seqsix_conv_exposant_tl
\int_new:N \l__seqsix_conv_rang_int
\int_new:N \l__seqsix_conv_hectares_int
\bool_new:N \l__seqsix_conv_prefixes_bool
\bool_new:N \l__seqsix_conv_valeurs_bool
\bool_new:N \l__seqsix_conv_note_bool
\bool_new:N \l__seqsix_conv_etiquettes_bool
