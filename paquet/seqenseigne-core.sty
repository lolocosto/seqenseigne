\newcommand{\seqPPRE@tmpExosF}{}%
\newcommand{\seqPPRE@tmpExosA}{}%
\newcommand{\seqPPRE@tmpExosE}{}%
\newcommand{\seqPPRE@tmpAideF}{}%
\newcommand{\seqPPRE@tmpAideA}{}%
\newcommand{\seqPPRE@tmpAideE}{}%

