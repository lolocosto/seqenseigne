\newcommand{\seqfc@setupgeometry}{%
    \ifseqfc@paysage
        % Demi-A4 paysage : 148 × 105 mm — 2 cartes par feuille A4
        \newgeometry{%
            paperwidth  = 148mm,
            paperheight = 105mm,
            left        = 6mm,
            right       = 6mm,
            top         = 6mm,
            bottom      = 6mm,
            nohead,
            nofoot
        }%
    \else
        % A6 portrait : 105 × 148 mm — 4 cartes par feuille A4
        \newgeometry{%
            paperwidth  = 105mm,
            paperheight = 148mm,
            left        = 5mm,
            right       = 5mm,
            top         = 5mm,
            bottom      = 5mm,
            nohead,
            nofoot
        }%
    \fi
}%

\AtBeginDocument{\seqfc@setupgeometry}%

\newcounter{seqfc@num}%
