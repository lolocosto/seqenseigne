% ---- Gestion des compteurs
\newcommand\seqCreeCompteurs{%
	\newcounter{NotionNum}%
	\newcounter{DefinitionNum}%
	\newcounter{ProprieteNum}%
	\newcounter{MethodeNum}%
	\newcounter{SerieExosNum}%
	\newcounter{ExoNum}%
	\newcounter{AnnexeNum}%
