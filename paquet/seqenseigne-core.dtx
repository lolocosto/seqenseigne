\newcommand{\seqTitreSection}[1]{%
	\ifdocstd
		\newpage
		\newgeometry{left=35pt,right=35pt,top=65pt,bottom=70pt}%
	\fi
	\begin{boiteTitreSection}%
		\begin{minipage}[c][20pt][c]{\linewidth}%
			\centering \Large \textbf{#1}%
		\end{minipage}%
	\end{boiteTitreSection}%
