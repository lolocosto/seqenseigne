    colframe=seqSixMauveBord!60, boxrule=0.5pt, arc=1pt, left=4pt, right=4pt,
    top=2pt, bottom=2pt, fontupper=\small]
  \textbf{Explications.} #1\end{tcolorbox}\fi}

