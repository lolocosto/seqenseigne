%% qui commence sur une page impaire
\newcommand{\seqAfficheCorrigesBilan}{%
	\immediate\closeout\corrfileeval
	\clearpage
	\ifodd\c@page\else
		\null\newpage
		\if@twocolumn\null\newpage\fi
	\fi
	\input{CorrList.tex}%
	\clearpage
	\ifodd\c@page\else
		\null\newpage
		\if@twocolumn\null\newpage\fi
	\fi

}%
%    \end{macro}%
